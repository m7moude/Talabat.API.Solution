@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "Index";
}
<h1>All Roles</h1>
<hr />
<partial name="Create" model="new CreateRoleViewModel()"/>
@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(r => r.Id)</th>
                <th>@Html.DisplayNameFor(r => r.Name)</th>
                <th>Actions</th>
            </tr>
        <thead />
        <tbody>
                @foreach (var role in Model)
                {
                <tr>
                    <td>@role.Id</td>
                    <td>@role.Name</td>
                    <td>
                        <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@role.Id">Edit</a>
                        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@role.Id">Delete</a>

                    </td>
                </tr>
                }
        </tbody>
    </table>
}
else
{
    <div class="m-3 p-3 alert-info">
        <h1> No Role ): </h1>
    </div>
}
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
